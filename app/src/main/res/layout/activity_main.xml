<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generar Códigos QR"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/azul_marino"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TARJETA CONTENEDORA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCSV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/blanco"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccionar archivo CSV"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/azul_marino"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Seleccionar"
                android:onClick="seleccionarCSV"
                android:textColor="@color/blanco"
                app:backgroundTint="@color/azul_marino"
                app:cornerRadius="14dp"
                app:icon="@drawable/baseline_upload_24"
                app:iconTint="@color/blanco"
                app:iconPadding="8dp"/>

            <TextView
                android:id="@+id/nombreCSV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ningún archivo seleccionado"
                android:textColor="@color/azul_marino_claro"
                android:layout_marginTop="12dp"
                android:visibility="visible"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- BOTÓN GENERAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerarQRs"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:text="Generar QRs"
        android:onClick="generarQRs"
        android:textColor="@color/blanco"
        android:textStyle="bold"
        app:backgroundTint="@color/naranja_acento"
        app:cornerRadius="18dp"
        app:elevation="6dp"
        app:icon="@drawable/ic_qr"
        app:iconTint="@color/blanco"
        app:iconPadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCSV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>