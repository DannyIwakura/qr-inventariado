<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo">

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tvTituloEscanear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escanear Código QR"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/azul_marino"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TARJETA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEscaneo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/blanco"
        app:layout_constraintTop_toBottomOf="@id/tvTituloEscanear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEscanearCamara"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Escanear con cámara"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                app:backgroundTint="@color/azul_marino"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_qr_code_scanner"
                app:iconTint="@color/blanco"
                app:iconPadding="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleLens"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:text="Escanear con Google Lens"
                android:textColor="@color/blanco"
                app:backgroundTint="@color/naranja_acento"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_photo_camera"
                app:iconPadding="8dp"
                app:iconTint="@color/blanco" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>